    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.84",
    "playwright-core": "1.65.0-alpha-2026-10-30"
  }
}
